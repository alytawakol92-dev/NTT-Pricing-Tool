{% macro letterhead(o, title) %}
<div class="lh">
  <div class="brand">NTT · Al-Tawakol
    <div class="ar">{{ o.company.arabic_name }}</div>
    <small>{{ o.company.partner_line }}</small>
  </div>
  <div class="doc"><h1>{{ title|upper }}</h1><div class="no">{{ o.offer_no }}</div></div>
</div>
{% endmacro %}

{% macro footer(o) %}
<div class="ft">
  <b>{{ o.company.name }}</b><br>
  {{ o.company.address_office }} &nbsp;·&nbsp; {{ o.company.address_factory }}<br>
  Tel: {{ o.company.tel }} &nbsp;·&nbsp; Fax: {{ o.company.fax }} &nbsp;·&nbsp; {{ o.company.website }}
</div>
{% endmacro %}

{% macro cover(o, title) %}
<div class="page">
  {{ letterhead(o, title) }}
  <div style="margin-top:26px;">
    <p style="font-size:13px;line-height:1.7;color:var(--ink);max-width:640px;">
      {{ o.company.intro }}
    </p>
    <ul style="font-size:12px;color:var(--muted);line-height:1.9;columns:2;margin:14px 0;">
      <li>Main &amp; Sub-main Switchboards up to 5000A</li>
      <li>Distribution &amp; Residential Switchboards</li>
      <li>ATS Switchboards (1/2, 1/3, 2/3, 2/4 …)</li>
      <li>Synchronization &amp; Phase-Correction Boards</li>
      <li>Motor Control Centers (DOL, Star-Delta, VSD …)</li>
      <li>Power Factor Correction Panels</li>
      <li>Busway, Cable Trays &amp; Galvanization</li>
      <li>Lighting Products &amp; Wiring Devices</li>
    </ul>
  </div>
  <div class="meta" style="margin-top:26px;border:1px solid var(--line);border-radius:8px;padding:16px;">
    <div><span>Offer No</span>{{ o.offer_no }}</div>
    <div><span>Client</span>{{ o.client }}</div>
    <div><span>Project</span>{{ o.project_name }}</div>
    <div><span>Date</span>{{ o.date }}</div>
  </div>
  <p style="font-size:12px;color:var(--muted);margin-top:24px;">
    We hope that our proposal satisfies your requirements &amp; for any further inquiries
    do not hesitate to contact us. &nbsp; Best regards.
  </p>
  {{ footer(o) }}
</div>
{% endmacro %}
