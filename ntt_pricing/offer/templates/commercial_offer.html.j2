<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Commercial Offer — {{ o.offer_no }}</title>
{% include "_style.html.j2" %}
<style>
  table.fin{font-size:12px;border:1px solid var(--line);margin-top:6px;}
  table.fin th{background:var(--head);color:#fff;font-size:10.5px;text-transform:uppercase;
               letter-spacing:.6px;padding:9px 12px;text-align:left;}
  table.fin th.n,table.fin td.n{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap;}
  table.fin th.c,table.fin td.c{text-align:center;width:60px;}
  table.fin td{padding:9px 12px;border-bottom:1px solid var(--line);}
  table.fin tr:nth-child(even) td{background:var(--zebra);}
  .tot{margin-left:auto;width:340px;margin-top:14px;font-size:12.5px;}
  .tot .r{display:flex;justify-content:space-between;padding:5px 2px;}
  .tot .grand{border-top:2px solid var(--brand);margin-top:6px;padding-top:9px;
              font-size:16px;font-weight:800;color:var(--brand);}
  .terms{margin-top:22px;}
  .term{border-left:3px solid var(--accent);padding:8px 14px;margin:8px 0;background:var(--zebra);
        border-radius:0 6px 6px 0;}
  .term .en{font-size:11.5px;color:var(--ink);}
  .term .ar{font-size:12px;color:var(--muted);direction:rtl;text-align:right;margin-top:3px;}
  .sign{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:34px;}
  .sign .box{border-top:1px solid var(--ink);padding-top:8px;text-align:center;font-size:11.5px;}
  .sign .box b{display:block;color:var(--brand);}
  .sign .box small{color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.6px;}
  .contacts{margin-top:16px;font-size:11px;color:var(--muted);}
</style>
</head><body>
{% import "_letterhead.html.j2" as L %}

{{ L.cover(o, "Commercial Offer") }}

<div class="page">
  {{ L.letterhead(o, "Commercial Offer") }}

  <div class="meta" style="grid-template-columns:repeat(3,1fr);margin-top:16px;">
    <div><span>To</span>{{ o.client }}</div>
    <div><span>Attention</span>{{ o.attention or "—" }}</div>
    <div><span>Offer No</span>{{ o.offer_no }}</div>
    <div><span>Project</span>{{ o.project_name }}</div>
    <div><span>Code</span>{{ o.code or "—" }}</div>
    <div><span>Date</span>{{ o.date }}</div>
  </div>

  <h2 class="sec">Financial Offer</h2>
  <table class="fin">
    <thead><tr>
      <th class="c">Item</th><th>Panel Name</th><th class="c">Qty</th>
      <th class="n">Unit Price ({{ o.currency_symbol }})</th>
      <th class="n">Total Price ({{ o.currency_symbol }})</th>
    </tr></thead>
    <tbody>
    {% for p in o.panels %}
      <tr>
        <td class="c">{{ p.item_no }}</td>
        <td>{{ p.name }}</td>
        <td class="c">{{ p.quantity }}</td>
        <td class="n">{{ o.currency_symbol }} {{ p.unit_price|money }}</td>
        <td class="n">{{ o.currency_symbol }} {{ p.total_price|money }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  <div class="tot">
    <div class="r"><span>Net Total ({{ o.currency }})</span><span>{{ o.currency_symbol }} {{ o.net_total()|money }}</span></div>
    <div class="r"><span>VAT ({{ o.tax_pct }}%)</span><span>{{ o.currency_symbol }} {{ o.tax_amount()|money }}</span></div>
    <div class="r grand"><span>Grand Total incl. Taxes</span><span>{{ o.currency_symbol }} {{ o.grand_total()|money }}</span></div>
  </div>

  <h2 class="sec">Terms &amp; Conditions</h2>
  <div class="terms">
    {% set T = o.terms %}
    {% for en, ar in [
        (T.tax_note_en, T.tax_note_ar), (T.validity_en, T.validity_ar),
        (T.payment_en, T.payment_ar), (T.delivery_period_en, T.delivery_period_ar),
        (T.delivery_place_en, T.delivery_place_ar), (T.storage_en, T.storage_ar),
        (T.currency_note_en, T.currency_note_ar)] %}
      <div class="term"><div class="en">• {{ en }}</div><div class="ar">{{ ar }}</div></div>
    {% endfor %}
  </div>

  <div class="sign">
    {% for s in o.signatories %}
      <div class="box"><b>{{ s.name }}</b><small>{{ s.title }}</small></div>
    {% endfor %}
  </div>
  <div class="contacts">Customer service &amp; complaints: {{ o.contacts|join("  ·  ") }}</div>

  {{ L.footer(o) }}
</div>
</body></html>
